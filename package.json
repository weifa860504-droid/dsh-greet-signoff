{
  "name": "dsh-greet-signoff",
  "version": "1.24.0",
  "description": "开场语与收尾语：每次回复固定开场/收尾（含文案池、场景、按工作区绑定），另带会话花费台账与换会话交接摘要。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "emoji-zh.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/client-pure.test.mjs test/host-pure.test.mjs",
    "verify": "node scripts/verify-manifest.mjs"
  },
  "license": "MIT",
  "author": "weifa860504-droid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weifa860504-droid/dsh-greet-signoff.git"
  },
  "homepage": "https://github.com/weifa860504-droid/dsh-greet-signoff#readme",
  "bugs": {
    "url": "https://github.com/weifa860504-droid/dsh-greet-signoff/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "chat",
    "status-bar",
    "ui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible"
      }
    }
  }
}
